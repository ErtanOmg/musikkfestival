    </div>

    <div class="bands">
        <img href="Band-programs/lade-boy.html" src="bilder/Good-Old-Fashioned-Lade-Boy.png" alt="">
        <a href="Band-programs/lade-boy.html">Lær mer om bandet!</a>
    </div>
</section>
</main>
